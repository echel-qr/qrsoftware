# Use a NEW Echel Supabase project. Copy its session pooler URL (port 5432).
DATABASE_URL=postgresql://postgres.PROJECT:PASSWORD@POOLER_HOST:5432/postgres
# Supabase's database CA certificate, when required; literal \n is supported.
DATABASE_SSL_CA=
JWT_SECRET=
SUPER_ADMIN_ID=
SUPER_ADMIN_PASSWORD=
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
OWNER_RAZORPAY_KEY_ID=
OWNER_RAZORPAY_KEY_SECRET=
# On Render, BASE_URL and SITE_URL default to RENDER_EXTERNAL_URL.
# Set both only after the custom domain is connected.
BASE_URL=
SITE_URL=
PORT=3000
